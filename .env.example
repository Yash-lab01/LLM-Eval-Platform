# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/llm_eval

# Redis (3 isolated logical databases)
REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Free-Tier LLM Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Langfuse Observability (Self-hosted or Cloud)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Application Security & Environment
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ENVIRONMENT=development
